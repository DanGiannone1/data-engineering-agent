{
  "version": "2.0",
  "logging": {
    "applicationInsights": {
      "samplingSettings": {
        "isEnabled": true,
        "excludedTypes": "Request"
      }
    },
    "logLevel": {
      "default": "Information",
      "Microsoft": "Warning",
      "Worker": "Information"
    }
  },
  "extensions": {
    "durableTask": {
      "hubName": "DataEngineeringAgent",
      "storageProvider": {
        "type": "AzureStorage"
      }
    },
    "http": {
      "routePrefix": "api"
    }
  },
  "functionTimeout": "00:30:00"
}
